#!/usr/bin/env node
// ScreenBrief CLI.
import { main } from '../src/cli.mjs';

main(process.argv.slice(2)).then(
  (code) => {
    if (typeof code === 'number') process.exitCode = code;
  },
  (err) => {
    console.error(`screenbrief: ${err && err.message ? err.message : err}`);
    process.exitCode = 1;
  },
);
